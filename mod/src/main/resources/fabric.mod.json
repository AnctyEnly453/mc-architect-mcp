{
  "schemaVersion": 1,
  "id": "mcarchitect",
  "version": "${version}",
  "name": "MC Engineer",
  "description": "Local Minecraft engineering: modular projects, resumable construction and redstone debugging.",
  "authors": [
    "MC Architect"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "main": [
      "dev.mcarchitect.McArchitectMod"
    ],
    "client": [
      "dev.mcarchitect.McArchitectClient"
    ]
  },
  "mixins": [
    "mcarchitect.mixins.json",
    "mcarchitect.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.6",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
